@model StudentTeacher.Mvc.Models.CourseCatalogueViewModel

@{
    ViewData["Title"] = "Available Courses";
}

<div class="container mt-4">
    <h2 class="mb-4">Available Courses</h2>

    <form asp-controller="Courses" asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-sm-5">
            <label asp-for="SelectedCategoryId" class="form-label">Filter by category</label>
            <select asp-for="SelectedCategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CourseCategoryId">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-auto align-self-end">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (!Model.Courses.Any())
    {
        <div class="alert alert-info">No courses match the selected category.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Course Title</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Teacher</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model.Courses)
                    {
                        <tr>
                            <td>@course.Code</td>
                            <td>@course.Title</td>
                            <td>@course.Description</td>
                            <td>@course.CategoryName</td>
                            <td>@course.TeacherFirstName @course.TeacherLastName</td>
                            <td>
                                <a asp-controller="Courses" asp-action="Details"
                                   asp-route-id="@course.CourseId" class="btn btn-primary btn-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
