@model StudentTeacher.Mvc.Models.CourseViewModel

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">

    <h2>Course Details</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="card-title">@Model.Title</h4>

            <p class="text-muted">
                Course Code: @Model.Code
            </p>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Description
                </dt>
                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <dt class="col-sm-3">
                    Category
                </dt>
                <dd class="col-sm-9">
                    @Model.CategoryName
                </dd>

                <dt class="col-sm-3">
                    Teacher
                </dt>
                <dd class="col-sm-9">
                    @Model.TeacherFirstName @Model.TeacherLastName
                </dd>

                <dt class="col-sm-3">
                    Date Created
                </dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("dd MMMM yyyy")
                </dd>

            </dl>

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Courses"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Courses
        </a>
    </div>

</div>
