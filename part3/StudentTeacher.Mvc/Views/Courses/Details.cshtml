@model StudentTeacher.Mvc.Models.CourseViewModel

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">

    <h2>Course Details</h2>
    <hr />

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning">@errorMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.CourseImageUrl))
            {
                <img src="@Model.CourseImageUrl"
                     alt="Course image for @Model.Title"
                     class="img-fluid rounded mb-3"
                     style="max-height: 300px; object-fit: cover;" />
            }

            <h4 class="card-title">@Model.Title</h4>

            <p class="text-muted">
                Course Code: @Model.Code
            </p>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Description
                </dt>
                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <dt class="col-sm-3">
                    Category
                </dt>
                <dd class="col-sm-9">
                    @Model.CategoryName
                </dd>

                <dt class="col-sm-3">
                    Teacher
                </dt>
                <dd class="col-sm-9">
                    @Model.TeacherFirstName @Model.TeacherLastName
                </dd>

                <dt class="col-sm-3">
                    Date Created
                </dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("dd MMMM yyyy")
                </dd>

            </dl>

        </div>
    </div>

    @if (Model.CanManageCourse)
    {
        <div class="mt-3 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.CourseId"
               class="btn btn-primary">Edit Course / Replace Image</a>
            <form asp-action="Delete" asp-route-id="@Model.CourseId"
                  method="post" onsubmit="return confirm('Delete this course?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete Course</button>
            </form>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Courses"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Courses
        </a>
    </div>

</div>
