@model StudentTeacher.Mvc.Models.CreateCourseViewModel
@{
    ViewData["Title"] = "Edit Course";
    int courseId = (int)ViewBag.CourseId;
    string? currentImageUrl = ViewBag.CurrentImageUrl as string;
}

<div class="container mt-4">
    <h2>Edit Course</h2>
    <hr />
    <form asp-controller="Courses" asp-action="Edit"
          asp-route-id="@courseId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="CourseCategoryId" class="form-label">Category</label>
            <select asp-for="CourseCategoryId" class="form-select">
                <option value="0">-- Select a category --</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CourseCategoryId">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CourseCategoryId" class="text-danger"></span>
        </div>
        @if (!string.IsNullOrWhiteSpace(currentImageUrl))
        {
            <div class="mb-3">
                <img src="@currentImageUrl" alt="Current course image"
                     class="img-fluid rounded" style="max-height: 200px" />
            </div>
        }
        <div class="mb-3">
            <label asp-for="Image" class="form-label">Replace course image (optional)</label>
            <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
            <div class="form-text">Leave empty to keep the current image. Maximum 5 MB.</div>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@courseId"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
