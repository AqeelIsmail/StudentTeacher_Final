@model StudentTeacher.Mvc.Models.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}
<div class="container mt-4">
    <h2>Teacher Dashboard</h2>
    <p class="text-muted">Your courses and current student enrolments, retrieved from the API.</p>

    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="card"><div class="card-body">
                <div class="text-muted">My courses</div>
                <h3>@Model.Courses.Count</h3>
            </div></div>
        </div>
        <div class="col-sm-6">
            <div class="card"><div class="card-body">
                <div class="text-muted">Total enrolments</div>
                <h3>@Model.TotalEnrolments</h3>
            </div></div>
        </div>
    </div>

    <div class="mb-3 d-flex gap-2">
        <a asp-controller="Courses" asp-action="Create" class="btn btn-primary">Create Course</a>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">Manage Categories</a>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary">Browse Courses</a>
    </div>

    @if (Model.Courses.Count == 0)
    {
        <div class="alert alert-info">You haven't created any courses yet.</div>
    }
    else
    {
        <table class="table table-striped table-responsive">
            <thead><tr><th>Code</th><th>Course</th><th>Enrolments</th>
                <th>Confirmed</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.Code</td>
                    <td>@course.Title</td>
                    <td>@course.EnrolmentCount</td>
                    <td>@course.ConfirmedCount</td>
                    <td><a asp-controller="Courses" asp-action="Details"
                        asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary">Details / Edit</a>
                        <a asp-controller="Enrolments" asp-action="Course" asp-route-id="@course.CourseId"
                           class="btn btn-sm btn-outline-secondary ms-1">Manage Enrolments</a>
                        <a asp-controller="Results" asp-action="Course" asp-route-id="@course.CourseId"
                           class="btn btn-sm btn-outline-primary ms-1">Course Results</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
