@{
    Layout = "_Layout";
    ViewData["Title"] = "Teacher Area";
}
@model string

<div class="container mt-4">

    <div class="p-4 mb-4 rounded shadow-sm text-white"
         style="background-color: #0d2647;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1">Teacher Area</h2>
                <p class="mb-0">Welcome, @Model</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Logout
                </button>

            </form>

        </div>
    </div>
</div>