@{
    Layout = "_Layout";
    ViewData["Title"] = "Student Area";
}
@model string

<div class="container mt-4">

    <div class="p-4 mb-4 rounded shadow-sm text-white"
         style="background-color: #198754;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1"> Student Area</h2>
                <p class="mb-0">Welcome, @Model</p>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-light">
                Logout
            </a>
        </div>
    </div>
</div>