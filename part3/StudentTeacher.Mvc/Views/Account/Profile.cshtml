@model StudentTeacher.Mvc.Models.StudentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2>My Student Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Profile.ProfileImageUrl))
            {
                <img src="@Model.Profile.ProfileImageUrl" alt="Student profile picture"
                     class="img-thumbnail mb-3" style="width:180px; height:180px; object-fit:cover;" />
            }
            else
            {
                <p class="text-muted">No profile picture uploaded yet.</p>
            }

            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Student Number:</strong> @Model.Profile.StudentNumber</p>
        </div>
    </div>

    <h4>Edit Name</h4>
    <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label for="firstName" class="form-label">First Name</label>
            <input id="firstName" name="firstName" class="form-control"
                   value="@Model.Profile.FirstName" maxlength="100" required />
        </div>
        <div class="mb-3">
            <label for="lastName" class="form-label">Last Name</label>
            <input id="lastName" name="lastName" class="form-control"
                   value="@Model.Profile.LastName" maxlength="100" required />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>

    <h4>Profile Picture</h4>
    <form asp-controller="Account" asp-action="UploadProfileImage" method="post"
          enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label for="image" class="form-label">Select JPG or PNG (up to 5 MB)</label>
        <input id="image" name="image" type="file" class="form-control mb-3"
               accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
        <button type="submit" class="btn btn-outline-primary">
            @(string.IsNullOrWhiteSpace(Model.Profile.ProfileImageUrl) ? "Upload Picture" : "Replace Picture")
        </button>
    </form>
</div>
